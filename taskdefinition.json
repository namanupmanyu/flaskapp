{
  "family": "flask-app",
  "taskDefinition": {
    "containerDefinitions": [
      {
        "name": "microservices-cluster",
        "image": "211125469773.dkr.ecr.ap-south-1.amazonaws.com/flask-app:latest",  // Replace with your actual image URI
        "memory": 512,
        "essential": true,
        "portMappings": [
          {
            "containerPort": 80,
            "hostPort": 80,
            "protocol": "tcp"
          },
          {
            "containerPort": 5000,
            "hostPort": 5000,
            "protocol": "tcp"
          }
        ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "flask-app-logs",
            "awslogs-region": "us-west-2",
            "awslogs-stream-prefix": "flask"
          }
        }
      }
    ],
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512"
  }
}
